<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault"
        android:usesCleartextTraffic="true">

        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Opened by tapping the complication: swipeable list of this
             block's not-yet-done rituals, swipe RIGHT to complete — relayed
             to the phone over Bluetooth (see PhoneMessenger), which does
             the actual backend call over Tailscale so this works off the
             home LAN too. -->
        <activity
            android:name=".RitualListActivity"
            android:exported="true"
            android:taskAffinity="" />

        <!-- The complication itself. Tap opens RitualListActivity (set as
             its tapAction in Neg1nComplicationService) — no config activity
             is declared here, since the complication's own DATA doesn't
             need configuring, only what tapping it opens. -->
        <service
            android:name=".Neg1nComplicationService"
            android:exported="true"
            android:icon="@drawable/ic_launcher_foreground"
            android:label="@string/complication_label"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <!-- SMALL_IMAGE + RANGED_VALUE + SHORT_TEXT, in preference order.
                 Found live (2026-09-08): the user's chosen watch-face slot
                 is a SHORT_TEXT/RANGED_VALUE family — SMALL_IMAGE never even
                 offered there, confirmed after declaring it alone made the
                 provider disappear from that slot's picker entirely.
                 RANGED_VALUE gives a native-looking progress ring (0-5, watch
                 face's own accent color) instead of plain text — any slot
                 that DOES accept images still gets the real 5-bar bitmap
                 (the watch face picks one type from this list, never more
                 than one at a time). -->
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="SMALL_IMAGE,RANGED_VALUE,SHORT_TEXT" />
            <!-- 900s (15min, matching the phone's own sync cadence) is the
                 reliable baseline refresh — onComplicationRequest pulls the
                 latest Data Layer value itself (DataLayerReader) rather than
                 depending on StatusListenerService's push having been
                 delivered (see that class's doc comment: GMS never
                 registered it as a listener for this sideloaded app).
                 requestUpdateAll() from StatusListenerService still fires
                 an earlier refresh whenever push delivery does happen to
                 work, so this is a ceiling on staleness, not the only path. -->
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="900" />
        </service>

        <!-- day-points, hcb, hcmp: status-only, no tap action (same as -1n
             before RitualListActivity existed) — the system falls back to
             "open the containing app" (MainActivity) since none of these
             set a tapAction. -->
        <service
            android:name=".DayPointsComplicationService"
            android:exported="true"
            android:icon="@drawable/ic_launcher_foreground"
            android:label="@string/complication_label_day_points"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="SMALL_IMAGE,SHORT_TEXT" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="900" />
        </service>

        <service
            android:name=".HcbComplicationService"
            android:exported="true"
            android:icon="@drawable/ic_launcher_foreground"
            android:label="@string/complication_label_hcb"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <!-- SHORT_TEXT only — see HcbComplicationService's doc comment:
                 RANGED_VALUE looked like the better native fit but the real
                 score can run deeply negative, which a range widget just
                 clamps to an invisible 0%. Plain text always shows the real
                 number. -->
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="SHORT_TEXT" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="900" />
        </service>

        <service
            android:name=".HcmpComplicationService"
            android:exported="true"
            android:icon="@drawable/ic_launcher_foreground"
            android:label="@string/complication_label_hcmp"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="SHORT_TEXT" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="900" />
        </service>

        <!-- Reacts to the phone pushing a fresh status over the Data Layer.
             All 4 paths (bug found 2026-09-08: this only ever matched
             /neg1n_status, so the OS never routed day-points/hcb/hcmp
             change events here at all, regardless of what onDataChanged
             itself handled — see that class's doc comment). -->
        <service
            android:name=".StatusListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:path="/neg1n_status" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:path="/neg1n_day_points" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:path="/neg1n_hcb" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:path="/neg1n_hcmp" />
            </intent-filter>
        </service>

    </application>
</manifest>
