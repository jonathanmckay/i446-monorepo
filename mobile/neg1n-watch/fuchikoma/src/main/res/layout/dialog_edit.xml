<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">
    <EditText
        android:id="@+id/desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="description" android:inputType="text" android:fontFamily="monospace" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <EditText
            android:id="@+id/start"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content"
            android:hint="HH:MM" android:inputType="time" android:fontFamily="monospace" />
        <EditText
            android:id="@+id/end"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content"
            android:hint="HH:MM (blank = ongoing)" android:inputType="time" android:fontFamily="monospace" />
    </LinearLayout>
    <Spinner
        android:id="@+id/project"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp">
        <Button
            android:id="@+id/splitTop"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="split ▲ top" />
        <Button
            android:id="@+id/splitBottom"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="split ▼ bottom" />
    </LinearLayout>
</LinearLayout>
