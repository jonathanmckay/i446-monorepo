{
  "_doc": "Sources for tools/triage/triage.py. Rules are checked in order; the first match wins. Actions: trash (to ~/.Trash, reversible), move (to dest; {year} = first 20xx in the name), unzip (extract, trash the zip, triage the output), queue (same name, different bytes; listed for review in the weekly /1-i446), review (listed, untouched). \"enabled\": false reports the rule as a proposal instead of acting. Ages count from the date the file landed in the folder (Spotlight kMDItemDateAdded).",
  "sources": {
    "downloads": {
      "path": "~/Downloads",
      "skip": [
        ".DS_Store",
        ".localized"
      ],
      "rules": [
        {
          "name": "git-repo",
          "git_repo": true,
          "action": "review",
          "note": "a git repository: belongs in ~/code, never in a synced folder (Syncthing corrupts .git)"
        },
        {
          "name": "office-lock",
          "glob": "~$*",
          "min_age_days": 1,
          "action": "trash"
        },
        {
          "name": "partial-download",
          "ext": [
            "crdownload",
            "part",
            "download"
          ],
          "min_age_days": 2,
          "action": "trash"
        },
        {
          "name": "duplicate-copy",
          "duplicate": true,
          "action": "trash"
        },
        {
          "name": "name-clash",
          "name_clash": true,
          "action": "queue",
          "note": "same name as a file beside it, different bytes: reviewed in the weekly /1-i446"
        },
        {
          "name": "zip-extracted",
          "extracted": true,
          "min_age_days": 2,
          "action": "trash",
          "note": "unpacked folder sits beside it"
        },
        {
          "name": "zip-app-installer",
          "app_zip": true,
          "min_age_days": 2,
          "action": "trash",
          "note": "zip holds a .app"
        },
        {
          "name": "lp-k1-copy",
          "regex": "(?i)k-?1\\b",
          "not_regex": "(?i)mckay",
          "min_age_days": 60,
          "action": "trash",
          "note": "another investor's K-1; m5x2 fund admin holds the original"
        },
        {
          "name": "lp-k1-pending",
          "regex": "(?i)k-?1\\b",
          "not_regex": "(?i)mckay",
          "action": "review",
          "note": "another investor's K-1; trashed at 60 days"
        },
        {
          "name": "tax-return",
          "regex": "(?i)tax ?return",
          "action": "move",
          "dest": "~/files/qz12/Income Taxes/{year} Tax/Filed Returns"
        },
        {
          "name": "tax-k1",
          "regex": "(?i)k-?1\\b",
          "action": "move",
          "dest": "~/files/qz12/Income Taxes/{year} Tax/k1"
        },
        {
          "name": "tax-form",
          "regex": "(?i)(taxdocuments|\\bw-?2\\b|1099|1098|1095)",
          "action": "move",
          "dest": "~/files/qz12/Income Taxes/{year} Tax"
        },
        {
          "name": "property-record",
          "regex": "(?i)cost segregation",
          "action": "review",
          "note": "file into Dropbox m5c7 - Real Estate"
        },
        {
          "name": "provider-export",
          "regex": "(?i)(statements?\\b|p&l)",
          "min_age_days": 30,
          "action": "move",
          "dest": "~/files/archive",
          "note": "re-downloadable from the bank / AppFolio"
        },
        {
          "name": "household-record",
          "regex": "(?i)(insurance|dependent|care profile|emergency.?form)",
          "action": "review",
          "note": "insurance / medical / school forms: file to hcbi or xk87, or Archive"
        },
        {
          "name": "work-confidential",
          "regex": "(?i)(\\bMBR\\b|\\bSLT\\b|attestation|xbox|blizzard|gaming store|pc-weekly-update)",
          "action": "move",
          "dest": "~/Library/CloudStorage/OneDrive-Microsoft/Downloads",
          "note": "Microsoft material belongs in Work OneDrive"
        },
        {
          "name": "work-content",
          "work_content": true,
          "action": "move",
          "dest": "~/Library/CloudStorage/OneDrive-Microsoft/Downloads",
          "note": "Microsoft material found by content (sensitivity label, Xbox/Microsoft markers)"
        },
        {
          "name": "installer",
          "ext": [
            "dmg",
            "pkg",
            "mpkg",
            "iso"
          ],
          "min_age_days": 14,
          "action": "trash"
        },
        {
          "name": "zip-other",
          "ext": [
            "zip"
          ],
          "min_age_days": 2,
          "action": "unzip",
          "note": "extracted, then triaged"
        },
        {
          "name": "image-twin",
          "ext": [
            "jpg",
            "jpeg",
            "png"
          ],
          "twin_exts": [
            "heic"
          ],
          "action": "queue",
          "note": "same photo as the HEIC beside it, different bytes: reviewed in the weekly /1-i446"
        },
        {
          "name": "camera-photo-in-library",
          "regex": "^(IMG_\\d+|FullSizeRender)",
          "ext": [
            "heic",
            "png",
            "jpg",
            "jpeg",
            "gif",
            "webp"
          ],
          "in_photos": true,
          "min_age_days": 7,
          "action": "trash",
          "note": "iCloud Photos holds the original"
        },
        {
          "name": "camera-photo",
          "regex": "^(IMG_\\d+|FullSizeRender)",
          "ext": [
            "heic",
            "png",
            "jpg",
            "jpeg",
            "gif",
            "webp"
          ],
          "min_age_days": 7,
          "action": "review",
          "note": "phone photo not found in iCloud Photos"
        },
        {
          "name": "image-to-screenshots",
          "ext": [
            "heic",
            "png",
            "jpg",
            "jpeg",
            "gif",
            "webp",
            "bmp",
            "tiff",
            "mov",
            "mp4"
          ],
          "min_age_days": 7,
          "action": "move",
          "dest": "~/screenshots",
          "rename": "screenshot",
          "note": "non-photo images per i446-photos-and-screenshots: date-first name, kept forever"
        },
        {
          "name": "stale",
          "min_age_days": 30,
          "action": "move",
          "dest": "~/files/archive"
        }
      ]
    },
    "desktop": {
      "path": "~/Desktop",
      "skip": [
        ".DS_Store",
        ".localized"
      ],
      "rules_from": "downloads"
    },
    "documents": {
      "path": "~/Documents",
      "skip": [
        ".DS_Store",
        ".localized",
        "Copilot",
        "Copilot 1",
        "Cowork",
        "Zoom",
        "Jonathan McKay (Jonathan's Autopilot)"
      ],
      "_skip_doc": "app-owned folders (Copilot, Cowork, Zoom, Autopilot write here); leave in place",
      "rules_from": "downloads"
    },
    "to-delete": {
      "path": "~/.to-delete",
      "_why": "Deletion queue: things that are probably junk, one YYYY-MM-DD folder per batch. A batch goes to the Trash 90 days after its date; from day 76 it is listed on the Sunday card so there are two weeks to rescue anything.",
      "skip": [
        ".DS_Store",
        "MANIFEST.tsv"
      ],
      "rules": [
        {
          "name": "queue-expired",
          "dated_min_days": 90,
          "action": "trash",
          "note": "deletion-queue batch past 90 days"
        },
        {
          "name": "queue-expiring",
          "dated_min_days": 76,
          "action": "review",
          "note": "trashed at 90 days; move anything worth keeping out of ~/.to-delete/<date>"
        },
        {
          "name": "queue-undated",
          "regex": ".",
          "not_regex": "^\\d{4}-\\d{2}-\\d{2}$",
          "action": "review",
          "note": "not in a dated batch folder; move it into ~/.to-delete/<today>"
        }
      ]
    },
    "to-delete-ix": {
      "path": "/Volumes/Ix Files/.to-delete",
      "_why": "Ix-side deletion queue for items too large for Straylight (e.g. 21 GB of source zips). Same rules as to-delete; run by Ix's daily triage cron. Skipped wherever the path doesn't exist.",
      "rules_from": "to-delete",
      "skip": [
        ".DS_Store",
        "MANIFEST.tsv"
      ]
    }
  },
  "classify": {
    "_doc": "tools/triage/classify.py. Destinations = folders under `areas` (minus `skip`), cut to `depth` levels with years templated, holding >= min_files files. `samples` example filenames per destination go in the prompt. apply moves at confidence >= threshold.",
    "root": "~/files",
    "areas": [
      "qz12",
      "h335",
      "g245",
      "i446",
      "i447",
      "i444",
      "s897",
      "xk87",
      "xk88",
      "hcbi",
      "hcmc",
      "o314",
      "o315",
      "m828",
      "jia1",
      "n156"
    ],
    "skip": [
      "archive",
      "_meta"
    ],
    "depth": 3,
    "min_files": 3,
    "samples": 6,
    "model": "sonnet",
    "batch": 20,
    "parallel": 4,
    "max_hydrate_mb": 10,
    "threshold": 0.7
  }
}
