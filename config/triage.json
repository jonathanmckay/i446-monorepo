{
  "_doc": "Sources for tools/triage/triage.py. Rules are checked in order; the first match wins. Actions: trash (to ~/.Trash, reversible), move (to dest), review (listed, untouched). Ages count from the date the file landed in the folder (Spotlight kMDItemDateAdded).",
  "sources": {
    "downloads": {
      "path": "~/Downloads",
      "skip": [
        "_old",
        ".DS_Store",
        ".localized"
      ],
      "rules": [
        {
          "name": "office-lock",
          "glob": "~$*",
          "min_age_days": 1,
          "action": "trash"
        },
        {
          "name": "partial-download",
          "ext": [
            "crdownload",
            "part",
            "download"
          ],
          "min_age_days": 2,
          "action": "trash"
        },
        {
          "name": "duplicate-copy",
          "duplicate": true,
          "action": "trash"
        },
        {
          "name": "sensitive-finance",
          "regex": "(?i)(tax ?return|taxdocuments|k-?1\\b|\\b1065\\b|\\b990|\\bw-?2\\b|1099|1095|statements?\\b|p&l|cost segregation|insurance|dependent|care profile|emergency.?form)",
          "action": "review",
          "note": "personal finance, tax, insurance, medical: file into qz12 / m5x2 / hcbi; never ages into _old"
        },
        {
          "name": "work-confidential",
          "regex": "(?i)(\\bMBR\\b|\\bSLT\\b|attestation|xbox|blizzard|gaming store|pc-weekly-update)",
          "action": "review",
          "note": "Microsoft material on a personal Mac: move to Work OneDrive or delete"
        },
        {
          "name": "installer",
          "ext": [
            "dmg",
            "pkg",
            "mpkg",
            "iso"
          ],
          "min_age_days": 14,
          "action": "trash"
        },
        {
          "name": "archive",
          "ext": [
            "zip"
          ],
          "min_age_days": 14,
          "action": "trash"
        },
        {
          "name": "image",
          "ext": [
            "heic",
            "png",
            "jpg",
            "jpeg"
          ],
          "min_age_days": 7,
          "action": "review",
          "note": "photos and screenshots triage"
        },
        {
          "name": "stale",
          "min_age_days": 30,
          "action": "move",
          "dest": "~/Downloads/_old/{yyyy-mm}"
        }
      ]
    }
  }
}
