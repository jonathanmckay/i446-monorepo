{
  "_doc": "Sources for tools/triage/triage.py. Rules are checked in order; the first match wins. Actions: trash (to ~/.Trash, reversible), move (to dest; {year} = first 20xx in the name), unzip (extract, trash the zip, triage the output), queue (duplicates; the weekly /1-i446 re-verifies and trashes them), review (listed, untouched). \"enabled\": false reports the rule as a proposal instead of acting. Ages count from the date the file landed in the folder (Spotlight kMDItemDateAdded).",
  "sources": {
    "downloads": {
      "path": "~/Downloads",
      "skip": [
        ".DS_Store",
        ".localized"
      ],
      "rules": [
        {
          "name": "office-lock",
          "glob": "~$*",
          "min_age_days": 1,
          "action": "trash"
        },
        {
          "name": "partial-download",
          "ext": [
            "crdownload",
            "part",
            "download"
          ],
          "min_age_days": 2,
          "action": "trash"
        },
        {
          "name": "duplicate-copy",
          "duplicate": true,
          "action": "queue",
          "note": "byte-identical copy; trashed by the weekly /1-i446"
        },
        {
          "name": "zip-extracted",
          "extracted": true,
          "min_age_days": 2,
          "action": "trash",
          "note": "unpacked folder sits beside it"
        },
        {
          "name": "zip-app-installer",
          "app_zip": true,
          "min_age_days": 2,
          "action": "trash",
          "note": "zip holds a .app"
        },
        {
          "name": "lp-k1-copy",
          "regex": "(?i)k-?1\\b",
          "not_regex": "(?i)mckay",
          "min_age_days": 60,
          "action": "trash",
          "note": "another investor's K-1; m5x2 fund admin holds the original"
        },
        {
          "name": "lp-k1-pending",
          "regex": "(?i)k-?1\\b",
          "not_regex": "(?i)mckay",
          "action": "review",
          "note": "another investor's K-1; trashed at 60 days"
        },
        {
          "name": "tax-return",
          "regex": "(?i)tax ?return",
          "action": "move",
          "dest": "~/Library/CloudStorage/Dropbox/qz12 - Finance/Income Taxes/{year} Tax/Filed Returns"
        },
        {
          "name": "tax-k1",
          "regex": "(?i)k-?1\\b",
          "action": "move",
          "dest": "~/Library/CloudStorage/Dropbox/qz12 - Finance/Income Taxes/{year} Tax/k1"
        },
        {
          "name": "tax-form",
          "regex": "(?i)(taxdocuments|\\bw-?2\\b|1099|1098|1095)",
          "action": "move",
          "dest": "~/Library/CloudStorage/Dropbox/qz12 - Finance/Income Taxes/{year} Tax"
        },
        {
          "name": "property-record",
          "regex": "(?i)cost segregation",
          "action": "review",
          "note": "file into Dropbox m5c7 - Real Estate"
        },
        {
          "name": "provider-export",
          "regex": "(?i)(statements?\\b|p&l)",
          "min_age_days": 30,
          "action": "move",
          "dest": "~/Archive",
          "note": "re-downloadable from the bank / AppFolio"
        },
        {
          "name": "household-record",
          "regex": "(?i)(insurance|dependent|care profile|emergency.?form)",
          "action": "review",
          "note": "insurance / medical / school forms: file to hcbi or xk87, or Archive"
        },
        {
          "name": "work-confidential",
          "regex": "(?i)(\\bMBR\\b|\\bSLT\\b|attestation|xbox|blizzard|gaming store|pc-weekly-update)",
          "action": "move",
          "dest": "~/Library/CloudStorage/OneDrive-Microsoft/Downloads",
          "note": "Microsoft material belongs in Work OneDrive"
        },
        {
          "name": "installer",
          "ext": [
            "dmg",
            "pkg",
            "mpkg",
            "iso"
          ],
          "min_age_days": 14,
          "action": "trash"
        },
        {
          "name": "zip-other",
          "ext": [
            "zip"
          ],
          "min_age_days": 2,
          "action": "unzip",
          "note": "extracted, then triaged"
        },
        {
          "name": "image-twin",
          "ext": [
            "jpg",
            "jpeg",
            "png"
          ],
          "twin_exts": [
            "heic"
          ],
          "action": "queue",
          "note": "converted copy of a HEIC beside it; trashed by the weekly /1-i446"
        },
        {
          "name": "camera-photo-in-library",
          "regex": "^(IMG_\\d+|FullSizeRender)",
          "ext": [
            "heic",
            "png",
            "jpg",
            "jpeg",
            "gif",
            "webp"
          ],
          "in_photos": true,
          "min_age_days": 7,
          "action": "trash",
          "note": "iCloud Photos holds the original"
        },
        {
          "name": "camera-photo",
          "regex": "^(IMG_\\d+|FullSizeRender)",
          "ext": [
            "heic",
            "png",
            "jpg",
            "jpeg",
            "gif",
            "webp"
          ],
          "min_age_days": 7,
          "action": "review",
          "note": "phone photo not found in iCloud Photos"
        },
        {
          "name": "image-to-screenshots",
          "ext": [
            "heic",
            "png",
            "jpg",
            "jpeg",
            "gif",
            "webp",
            "bmp",
            "tiff",
            "mov",
            "mp4"
          ],
          "min_age_days": 7,
          "action": "move",
          "dest": "~/screenshots",
          "rename": "screenshot",
          "note": "non-photo images per i446-photos-and-screenshots: date-first name, kept forever"
        },
        {
          "name": "stale",
          "min_age_days": 30,
          "action": "move",
          "dest": "~/Archive"
        }
      ]
    }
  }
}
