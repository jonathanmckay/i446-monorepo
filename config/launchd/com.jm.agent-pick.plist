<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- agent-picks pilot (tools/pick/run.py): 06:00 daily on Ix, 2026-11-09 to 11-22.
     Install: cp to ~/Library/LaunchAgents/ && launchctl bootstrap gui/$(id -u) <that path> -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jm.agent-pick</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/mckay/i446-monorepo/tools/pick/run.py</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>6</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/mckay/Library/Logs/agent-pick.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/mckay/Library/Logs/agent-pick.log</string>
</dict>
</plist>
