<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Same-day Neon ledger drift card (tools/neon-ledger/sameday.py), 22:30 daily.
  Replaces the config/ix.crontab line (2026-11-06): the Claude permission
  classifier blocked installing it via crontab twice, so launchd owns it.
  Install on Ix (not loaded by the repo):
    cp ~/i446-monorepo/config/launchd/com.mckay.neon-sameday.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$UID ~/Library/LaunchAgents/com.mckay.neon-sameday.plist
  A missed 22:30 (Mac asleep) runs at the next wake, as StartCalendarInterval does.
-->
<plist version="1.0">
<dict>
    <key>Label</key><string>com.mckay.neon-sameday</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/mckay/i446-monorepo/tools/neon-ledger/sameday.py</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>22</integer>
        <key>Minute</key><integer>30</integer>
    </dict>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/Users/mckay/bin</string>
    </dict>
    <key>StandardOutPath</key><string>/Users/mckay/.cache/neon-rules/sameday.log</string>
    <key>StandardErrorPath</key><string>/Users/mckay/.cache/neon-rules/sameday.log</string>
</dict>
</plist>
